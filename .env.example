# Local development environment for the public website.
# For Supabase, use the Transaction Pooler connection string (port 6543)
# or the Session Pooler connection string (port 5432) as DATABASE_URL.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-local-secret
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8000
PORTAL_URL=https://portal.affordax.com
SITE_NAME=Affordax
SITE_DESCRIPTOR=Affordability and payroll, connected
ENQUIRY_NOTIFICATION_EMAIL=
DEFAULT_FROM_EMAIL=website@localhost

# Optional SMTP settings. The development default prints emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
